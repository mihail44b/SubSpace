# Copy to .env only when .env does not exist. Never commit real credentials.
# Use separate values locally and on the VPS. Hex passwords avoid URL escaping issues.
POSTGRES_USER=subspace
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_DB=subspace
JWT_SECRET_KEY=replace_with_random_secret

# Optional: only for running Python directly on the host.
# Keep credentials consistent with POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://subspace:replace_with_random_hex_password@localhost:15432/subspace

# Email (SMTP) settings for registration and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# VPS only: replace with the FULL commit SHA of a successfully published image.
APP_IMAGE=ghcr.io/mihail44b/subspace:replace_with_published_commit_sha
